# ===== AI 服务配置示例 =====
# 复制为 .env（或直接设置环境变量）。
# 优先级：应用「设置」页写入的 data/settings.json > 环境变量 > 内置默认。

# 服务商：deepseek | ark | custom
NOVEL_AI_PROVIDER=deepseek

# API Key（二选一，按 provider 填）
NOVEL_AI_API_KEY=your_api_key_here
# 也兼容：DEEPSEEK_API_KEY / ARK_API_KEY

# 可选：覆盖默认 base_url / 模型
# NOVEL_AI_BASE_URL=https://api.deepseek.com
# NOVEL_AI_MODEL=deepseek-chat

# 可选：后端端口（默认 8778，前端 vite 代理会同步）
# NOVEL_BACKEND_PORT=8778
